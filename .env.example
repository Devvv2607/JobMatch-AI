# Copy to .env and edit. `docker compose up` works without a .env: every value
# below has a development default in docker-compose.yml. Never commit .env.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

# --- Database and Redis (defaults point at the Compose services) -------------
POSTGRES_USER=jobmatch
POSTGRES_PASSWORD=jobmatch
POSTGRES_DB=jobmatch
DATABASE_URL=postgresql+psycopg://jobmatch:jobmatch@db:5432/jobmatch
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
REDIS_URL=redis://redis:6379/0

# --- Auth --------------------------------------------------------------------
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900       # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=1209600  # 14 days
COOKIE_SECURE=false                # true behind HTTPS
COOKIE_SAMESITE=lax                # lax | strict | none
CORS_ORIGINS=http://localhost:3000 # comma-separated, exact origins only

# --- Rate limits ---------------------------------------------------------------
RATE_LIMIT_CREDENTIALS_IP_PER_MINUTE=10       # login + register, per client IP
LOGIN_FAILURE_LIMIT=5                         # failed login/register attempts per email...
LOGIN_FAILURE_WINDOW_SECONDS=900              # ...within this window (starts at first failure)
RATE_LIMIT_REFRESH_PER_FAMILY_PER_MINUTE=30   # token refreshes per login (not per IP)
REFRESH_FAILURE_LIMIT=20                      # failed refreshes (bad token) per IP...
REFRESH_FAILURE_WINDOW_SECONDS=600            # ...within this window
RATE_LIMIT_DEFAULT_PER_MINUTE=120             # other authenticated endpoints, per user
# Reverse proxies in front of the API that append to X-Forwarded-For. Keep 0 unless
# the API is only reachable through that many proxies; see docs/deploy.md.
TRUSTED_PROXY_COUNT=0

# --- LLM providers -----------------------------------------------------------
# Tried in this order; a provider with no key is skipped. Ollama needs no key.
LLM_PROVIDER_ORDER=groq,gemini,ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Small non-reasoning model for short outputs (the match sentence).
GROQ_FAST_MODEL=openai/gpt-oss-20b    # optional faster override: qwen/qwen3.8-27b with GROQ_FAST_REASONING_EFFORT=none (Preview model)
GROQ_FAST_REASONING_EFFORT=low
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Adzuna job search API (free key from developer.adzuna.com); empty = source skipped.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Free testing tier: 25 calls/minute; 250/day, 1,000/week, 2,500/month assumed (standard
# testing limits). The adapter pauses at 80% of the minute and stops at 80% of the rest.
ADZUNA_MINUTE_CALL_LIMIT=25
ADZUNA_DAILY_CALL_LIMIT=250
ADZUNA_WEEKLY_CALL_LIMIT=1000
ADZUNA_MONTHLY_CALL_LIMIT=2500
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3                  # retries per provider on 429/5xx/timeouts
LLM_REPAIR_ATTEMPTS=2              # extra attempts when output fails schema validation

# --- Embeddings (model is baked into the backend image) ------------------------
EMBEDDING_THREADS=0                  # 0 lets onnxruntime choose

# --- Ingestion -----------------------------------------------------------------
INGEST_CRON_ENABLED=true             # daily ingest in the worker (+ catch-up on start); `make ingest` runs it by hand
INGEST_CRON_HOURS=3                  # hours in INGEST_CRON_TIMEZONE, comma-separated
INGEST_CRON_MINUTE=0
INGEST_CRON_TIMEZONE=Asia/Kolkata
INGEST_CATCHUP_AFTER_HOURS=24        # on worker start, ingest once if the last success is older
INGEST_CONCURRENCY=4                 # boards fetched in parallel
INGEST_STALE_AFTER_DAYS=45           # unchanged this long: flagged stale (possible ghost listing)
INGEST_EXPIRE_AFTER_MISSED_RUNS=2    # missing from this many consecutive runs: expired
INGEST_NEAR_DUPLICATE_THRESHOLD=0.9  # word-set overlap (Jaccard) for text near-duplicates
INGEST_NEAR_DUPLICATE_CANONICAL_MIN=0.85  # a chained duplicate must also score this against the kept job
REMOTIVE_MIN_INTERVAL_HOURS=6        # Remotive asks for at most 4 fetches a day

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Host ports (change if something else is using them) ---------------------
API_PORT=8000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
