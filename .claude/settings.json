{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./eval/private/**)",
      "Bash(docker compose down:*)",
      "Bash(docker-compose down:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker image prune:*)",
      "Bash(docker container prune:*)",
      "Bash(docker builder prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)",
      "Bash(cat .env:*)",
      "Bash(cat backend/.env:*)",
      "PowerShell(docker compose down:*)",
      "PowerShell(docker system prune:*)",
      "PowerShell(docker volume rm:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(Get-Content .env:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
