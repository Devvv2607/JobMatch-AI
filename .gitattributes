# Code runs in Linux containers, so everything text is LF regardless of the host.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.ico binary
*.woff2 binary

# The decision log is append-only, one row per line, so a union merge keeps every
# branch's rows instead of conflicting (see CLAUDE.md).
docs/decisions/log.md merge=union
